<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/tv_greeting"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🌳 Namma-Hasiru"
            android:textSize="26sp" android:textColor="#1B5E20" android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Our Green Mission"
            android:textSize="13sp" android:textColor="#558B2F" android:layout_marginBottom="16dp"/>

        <!-- Survival Score Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp" app:cardBackgroundColor="#2E7D32">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌱 Survival Score" android:textColor="#FFFFFF" android:textSize="15sp"/>
                <TextView android:id="@+id/tv_survival_score"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%" android:textColor="#A5D6A7"
                    android:textSize="44sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_stats"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 planted • 0 sprouted"
                    android:textColor="#C8E6C9" android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Plants Logged card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_plants_logged"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp" app:cardBackgroundColor="#388E3C">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪴 Plants Logged"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_logged_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 plants total"
                        android:textColor="#C8E6C9" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#FFFFFF" android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pending Checkups card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_pending"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp" app:cardBackgroundColor="#F57F17">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏰ Pending Check-ups"
                        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_pending_count"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0 plants need attention"
                        android:textColor="#FFF9C4" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="#FFFFFF" android:textSize="28sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Species Guide Search -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔍 Species Guide"
            android:textSize="17sp" android:textColor="#2E7D32" android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Enter species name (e.g. Neem, Banyan)"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="#2E7D32" app:hintTextColor="#2E7D32">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_species_search"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#000000" android:imeOptions="actionSearch"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button android:id="@+id/btn_species_search"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Search Species" android:backgroundTint="#2E7D32"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_species_result"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:visibility="gone"
            app:cardCornerRadius="10dp" app:cardBackgroundColor="#E8F5E9">
            <TextView android:id="@+id/tv_species_result"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:textColor="#1B5E20" android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>
        </androidx.cardview.widget.CardView>

        <!-- Recent Plants -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📋 Recent Plants"
            android:textSize="17sp" android:textColor="#2E7D32" android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_plants"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
