<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFF8E1">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⏰ Pending Check-ups"
        android:textSize="22sp" android:textColor="#E65100" android:textStyle="bold"
        android:padding="16dp"/>

    <TextView android:id="@+id/tv_pending_empty"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✅ No pending check-ups!"
        android:textSize="16sp" android:textColor="#558B2F"
        android:padding="24dp" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pending"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="8dp"/>
</LinearLayout>